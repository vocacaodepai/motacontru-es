# Banco de produção (Supabase → Project Settings → Database → Connection string → "Transaction pooler").
# Sem esta variável, o sistema usa um Postgres local embutido (data/pg) — só para desenvolvimento.
DATABASE_URL=postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Opcional, recomendado em produção: código exigido para criar o primeiro administrador.
SETUP_TOKEN=troque-por-um-codigo-secreto

# Chave da API da Anthropic (console.anthropic.com). Só para ler extratos em PDF/foto com IA. Pode ficar vazia.
ANTHROPIC_API_KEY=sk-ant-...
# Opcional: modelo usado nos extratos (padrão claude-opus-5-5; um modelo menor reduz custo e tempo).
#ANTHROPIC_MODEL=claude-opus-5-5

# Só para demonstração (dados fictícios): popula obras, equipe etc. na primeira execução com banco vazio.
#DEMO=1
#DEMO_SENHA=mota2026

# Avisos por WhatsApp (opcional): webhook do provedor (recebe POST {to, text}) e segredo da rotina diária.
#WHATSAPP_WEBHOOK_URL=https://seu-provedor.exemplo/enviar
#WHATSAPP_TOKEN=
#CRON_SECRET=troque-por-um-segredo
